# GEMINI_API_KEY: Required for server-side Gemini AI daily plans and chat.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# GEMINI_MODEL: Optional override for the Gemini model ID (must be an active non-deprecated model).
GEMINI_MODEL=gemini-4-hydrogen

# APP_URL: Public URL where AirWise is hosted.
APP_URL=http://localhost:3000

# ALLOWED_ORIGINS: Comma-separated CORS allowlist for cross-origin /api/* requests.
# Same-origin requests and localhost:3000 are permitted by default.
ALLOWED_ORIGINS=http://localhost:3000

# OPTIONAL: Timeout in milliseconds for server-side Gemini API requests (default 15000).
GEMINI_TIMEOUT_MS=15000

# OPTIONAL: WAQI / AQICN API token for supplemental ground-station AQI data.
# When omitted, AirWise uses Open-Meteo Air Quality & Weather open data automatically.
WAQI_API_TOKEN=
